<% content_for :title, "Repairs — Wheelhouse" %>

<h1>Repairs</h1>

<% if @repairs.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Status</th>
        <th>Promised</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Mechanic</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "row", collection: @repairs, as: :repair %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No repairs yet.</p>
<% end %>
