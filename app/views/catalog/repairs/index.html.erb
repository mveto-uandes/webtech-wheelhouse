<% content_for :title, "Repairs — Wheelhouse" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Repairs</h1>
  <%= link_to "Take in a repair", new_catalog_repair_path, class: "btn btn-primary" %>
</div>

<% if @repairs.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Status</th>
        <th>Promised</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Mechanic</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "row", collection: @repairs, as: :repair %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No repairs yet.</p>
<% end %>
