<%= form_with model: [ :catalog, employee ] do |f| %>
  <%= render "shared/form_errors", object: employee %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(f.object, :name) %>
    <%= field_errors(f.object, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: field_class(f.object, :role), list: "employee_roles" %>
    <datalist id="employee_roles">
      <option value="mechanic"></option>
      <option value="counter"></option>
    </datalist>
    <%= field_errors(f.object, :role) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", cancel_path, class: "btn btn-link" %>
<% end %>
