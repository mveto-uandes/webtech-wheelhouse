<% content_for :title, "Staff — Wheelhouse" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Staff</h1>
  <%= link_to "New staff member", new_catalog_employee_path, class: "btn btn-primary" %>
</div>

<% if @employees.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Role</th>
        <th>Repairs assigned</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "row", collection: @employees, as: :employee %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No employees yet.</p>
<% end %>
