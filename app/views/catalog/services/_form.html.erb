<%= form_with model: [ :catalog, service ] do |f| %>
  <%= render "shared/form_errors", object: service %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(f.object, :name) %>
    <%= field_errors(f.object, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :price, class: "form-label" %>
    <%= f.number_field :price, step: 0.01, class: field_class(f.object, :price) %>
    <%= field_errors(f.object, :price) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", cancel_path, class: "btn btn-link" %>
<% end %>
