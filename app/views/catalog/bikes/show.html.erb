<% content_for :title, "#{@bike.make} #{@bike.model} — Wheelhouse" %>

<p><%= link_to "← All bikes", catalog_bikes_path %></p>

<h1><%= @bike.make %> <%= @bike.model %></h1>

<% record_policy = policy(@bike) %>
<% if record_policy.edit? || record_policy.destroy? %>
  <div class="d-flex gap-2 mb-4">
    <% if record_policy.edit? %>
      <%= link_to "Edit", edit_catalog_bike_path(@bike), class: "btn btn-outline-primary" %>
    <% end %>
    <% if record_policy.destroy? %>
      <%= button_to "Delete", catalog_bike_path(@bike), method: :delete,
            class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete bike #{@bike.serial_number}? This can't be undone." } } %>
    <% end %>
  </div>
<% end %>

<dl class="row">
  <dt class="col-sm-2">Color</dt>
  <dd class="col-sm-10"><%= @bike.color %></dd>

  <dt class="col-sm-2">Serial #</dt>
  <dd class="col-sm-10"><%= @bike.serial_number %></dd>

  <dt class="col-sm-2">Owner</dt>
  <dd class="col-sm-10"><%= link_if_allowed @bike.customer.name, @bike.customer, catalog_customer_path(@bike.customer) %></dd>
</dl>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
  <h2 class="h4 mb-0">Repairs</h2>
  <% if policy(Repair).new? %>
    <%= link_to "Take in a repair", new_catalog_repair_path(bike_id: @bike.id), class: "btn btn-sm btn-outline-primary" %>
  <% end %>
</div>
<% if @repairs.any? %>
  <%= render "catalog/repairs/table", repairs: @repairs %>
<% else %>
  <p class="text-muted">No repairs on file.</p>
<% end %>
