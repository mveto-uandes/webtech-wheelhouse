<%= form_with model: [ :catalog, bike ] do |f| %>
  <%= render "shared/form_errors", object: bike %>

  <div class="mb-3">
    <%= f.label :customer_id, class: "form-label" %>
    <%= f.collection_select :customer_id, Customer.by_name, :id, :name,
          { prompt: "Choose the owner" }, class: field_class(f.object, :customer, "form-select") %>
    <%= field_errors(f.object, :customer) %>
  </div>

  <div class="mb-3">
    <%= f.label :make, class: "form-label" %>
    <%= f.text_field :make, class: field_class(f.object, :make) %>
    <%= field_errors(f.object, :make) %>
  </div>

  <div class="mb-3">
    <%= f.label :model, class: "form-label" %>
    <%= f.text_field :model, class: field_class(f.object, :model) %>
    <%= field_errors(f.object, :model) %>
  </div>

  <div class="mb-3">
    <%= f.label :color, class: "form-label" %>
    <%= f.text_field :color, class: field_class(f.object, :color) %>
    <%= field_errors(f.object, :color) %>
  </div>

  <div class="mb-3">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: field_class(f.object, :serial_number) %>
    <%= field_errors(f.object, :serial_number) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", cancel_path, class: "btn btn-link" %>
<% end %>
