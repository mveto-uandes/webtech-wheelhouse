<% content_for :title, "Bikes — Wheelhouse" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Bikes</h1>
  <%= link_to "New bike", new_catalog_bike_path, class: "btn btn-primary" %>
</div>

<% if @bikes.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Color</th>
        <th>Serial #</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "row", collection: @bikes, as: :bike %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No bikes yet.</p>
<% end %>
