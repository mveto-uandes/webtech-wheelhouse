<% content_for :title, "#{@customer.name} — Wheelhouse" %>

<p><%= link_to "← All customers", catalog_customers_path %></p>

<h1><%= @customer.name %></h1>

<div class="d-flex gap-2 mb-4">
  <%= link_to "Edit", edit_catalog_customer_path(@customer), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", catalog_customer_path(@customer), method: :delete,
        class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete customer #{@customer.name}? This can't be undone." } } %>
</div>

<dl class="row">
  <dt class="col-sm-2">Phone</dt>
  <dd class="col-sm-10"><%= @customer.phone %></dd>
</dl>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
  <h2 class="h4 mb-0">Bikes</h2>
  <%= link_to "Add a bike", new_catalog_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-outline-primary" %>
</div>
<% if @bikes.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Make</th>
        <th>Model</th>
        <th>Color</th>
        <th>Serial #</th>
      </tr>
    </thead>
    <tbody>
      <% @bikes.each do |bike| %>
        <tr>
          <td><%= link_to bike.make, catalog_bike_path(bike) %></td>
          <td><%= bike.model %></td>
          <td><%= bike.color %></td>
          <td><%= bike.serial_number %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No bikes on file.</p>
<% end %>
