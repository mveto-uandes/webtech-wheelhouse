<% content_for :title, "Customers — Wheelhouse" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Customers</h1>
  <%= link_to "New customer", new_catalog_customer_path, class: "btn btn-primary" %>
</div>

<% if @customers.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>Bikes</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "row", collection: @customers, as: :customer %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No customers yet.</p>
<% end %>
