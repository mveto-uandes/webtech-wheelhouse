<h1>Services</h1>

<p class="lead">Here's what we do, and what it costs.</p>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Service</th>
      <th>Price</th>
    </tr>
  </thead>
  <tbody>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= job[:name] %></td>
        <td>$<%= job[:price] %></td>
      </tr>
    <% end %>
  </tbody>
</table>
