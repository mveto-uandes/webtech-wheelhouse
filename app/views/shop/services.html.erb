<h1>Services</h1>

<p class="lead">Here's what we do, and what it costs.</p>

<div class="row g-3">
  <% @jobs.each do |job| %>
    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
      <div class="card h-100 text-center">
        <div class="card-body">
          <h2 class="h5 card-title"><%= job[:name] %></h2>
          <p class="card-text fs-4">$<%= job[:price] %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<p class="mt-4 text-muted">
  Staff: <%= link_to "view bikes currently in the shop", mockup_repair_board_path %>.
</p>
