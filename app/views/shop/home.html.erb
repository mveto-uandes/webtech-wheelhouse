<h1>Wheelhouse</h1>

<div class="row align-items-center">
  <div class="col-lg-8 col-12">
    <p class="lead">
      Wheelhouse is the neighborhood bike shop for tune-ups, repairs, and honest advice.
    </p>
    <p>
      Bring your bike in and we'll get it running right. Check our <%= link_to "services and prices", services_path %>,
      find out about <%= link_to "visiting the workshop", visiting_path %>, or <%= link_to "learn about us", about_path %>.
    </p>
  </div>
  <div class="col-lg-4 col-12">
    <div class="p-4 bg-light rounded">
      <h2>Quick links</h2>
      <ul class="list-unstyled">
        <li><%= link_to "Services & Prices", services_path %></li>
        <li><%= link_to "Visiting the Workshop", visiting_path %></li>
        <li><%= link_to "About", about_path %></li>
      </ul>
    </div>
  </div>
</div>
