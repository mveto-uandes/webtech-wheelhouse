<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Webtech Wheelhouse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Webtech Wheelhouse">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path 'logo-32.png' %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path 'logo-180.png' %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# A visitor sees only the price list and the way in. A signed-in account sees the pages its policies open. %>
    <% signed_in = authenticated? %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <%= link_to policy(:shop).home? ? root_path : services_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
          <%= image_tag "logo.png", alt: "Wheelhouse logo", height: 40 %>
          <span>Wheelhouse</span>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% shop = policy(:shop) %>
            <% if shop.home? %>
              <li class="nav-item">
                <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
              </li>
            <% end %>
            <li class="nav-item">
              <%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
            </li>
            <% if shop.visiting? %>
              <li class="nav-item">
                <%= link_to "Visiting the Workshop", visiting_path, class: "nav-link #{'active' if current_page?(visiting_path)}" %>
              </li>
            <% end %>
            <% if shop.about? %>
              <li class="nav-item">
                <%= link_to "About", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
              </li>
            <% end %>
            <%# Records: only the indexes this account's policies open. A visitor gets none. %>
            <% records = [
                 [ "Customers", Customer, catalog_customers_path ],
                 [ "Bikes", Bike, catalog_bikes_path ],
                 [ "Staff", Employee, catalog_employees_path ],
                 [ "Service Catalog", Service, catalog_services_path ],
                 [ "Repairs", Repair, catalog_repairs_path ],
                 [ "Payments", Payment, catalog_payments_path ]
               ].select { |_label, model, _path| policy(model).index? } %>
            <% if signed_in && records.any? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle <%= 'active' if request.path.start_with?('/catalog') %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  Records
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <% records.each do |label, _model, path| %>
                    <li><%= link_to label, path, class: "dropdown-item #{'active' if request.path.start_with?(path)}" %></li>
                  <% end %>
                </ul>
              </li>
            <% end %>
          </ul>
          <% if signed_in %>
            <div class="d-flex align-items-center gap-2 ms-lg-3">
              <span class="navbar-text">
                <%= Current.user.display_name %>
                <span class="badge text-bg-light"><%= Current.user.role.humanize %></span>
              </span>
              <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-sm btn-outline-light" %>
            </div>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "btn btn-sm btn-outline-light ms-lg-3" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container my-4">
      <% flash.each do |type, message| %>
        <div class="alert <%= flash_class(type) %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
