<% content_for :title, "Forgot your password? — Wheelhouse" %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1>Forgot your password?</h1>
    <p class="text-body-secondary">Write your account's email address and we'll send you a link to choose a new one.</p>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email address", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: "form-control" %>
      </div>

      <%= form.submit "Email me a link", class: "btn btn-primary" %>
      <%= link_to "Back to sign in", new_session_path, class: "btn btn-link" %>
    <% end %>
  </div>
</div>
