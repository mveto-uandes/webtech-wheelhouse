<h1>Quote for: <%= @bike[:type] %> — <%= @bike[:make] %> <%= @bike[:model] %> (<%= @bike[:serial] %>)</h1>
<p class="text-muted">Mockup only — counter/staff view.</p>

<div class="row">
  <div class="col-lg-8 col-12">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Item</th>
          <th>ID</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td><%= item[:name] %></td>
            <td><%= item[:id] %></td>
            <td>$<%= "%.2f" % item[:price] %></td>
            <td><%= item[:quantity] %></td>
            <td>$<%= "%.2f" % item[:total] %></td>
            <td>
              <% if item[:status] == :accepted %>
                <span class="text-success">✓ Accepted</span>
              <% else %>
                <span class="text-danger">✗ Denied</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4"><strong>Total</strong></td>
          <td colspan="2"><strong>$<%= "%.2f" % @items.sum { |i| i[:total] } %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="col-lg-4 col-12">
    <div class="border rounded p-4 text-center text-muted">
      <div>[bike photo]</div>
    </div>
  </div>
</div>

<p class="mt-4">
  <%= link_to "← Back to repair board", mockup_repair_board_path %>
</p>
