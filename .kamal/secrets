# Secrets for config/deploy.yml. This file is committed and holds NO values: each
# line reads the value on the laptop when Kamal runs. See docs/deployment.md.

# Docker Hub access token (Account settings → Personal access tokens), Read & Write.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Password of the PostgreSQL accessory. The same value creates the database role
# (POSTGRES_PASSWORD) and lets the app sign in to it.
POSTGRES_PASSWORD=$WHEELHOUSE_DB_PASSWORD
WEBTECH_WHEELHOUSE_DATABASE_PASSWORD=$WHEELHOUSE_DB_PASSWORD

# Key of the production credentials (config/credentials/production.yml.enc), kept
# only on the laptop and ignored by git and Docker. The SMTP password is inside
# those credentials, so it reaches the server through this key.
RAILS_MASTER_KEY=$(cat config/credentials/production.key)
